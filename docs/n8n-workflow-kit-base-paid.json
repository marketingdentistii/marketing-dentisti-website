{
  "_note": "DRAFT — NON IMPORTARE N8N FINCHÉ IL DEPLOY NETLIFY SULLA PREVIEW NON È CONFERMATOK",
  "_env_requires": [
    "STRIPE_SECRET_KEY (solo per eventuale debugging, non necessario nel webhook)",
    "STRIPE_SIGNING_SECRET (dal Stripe Dashboard → Webhooks → endpoint signing secret)",
    "GOOGLE_SHEETS_API_CREDENTIALS (service account JSON per Google Sheets API v4)",
    "MAILERSEND_API_KEY o SENDGRID_API_KEY (per l'invio email)"
  ],
  "name": "[DRAFT] Kit Base - Consegna Pagata",
  "nodes": [
    {
      "_id": "trigger-webhook",
      "name": "Webhook Stripe: checkout.session.completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "stripe-kit-base-webhook",
      "credentials": {},
      "continueRegularOutput": true,
      "attributes": {
        "httpMethod": "POST",
        "path": "stripe-kit-base-webhook",
        "responseMode": "lastNode",
        "nodeData": {
          "replyData": {
            "responseBody": "{ \"received\": true }"
          }
        }
      },
      "discoveredAttributes": {}
    },
    {
      "_id": "filter-event",
      "name": "Filter: Solo checkout.session.completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, 300],
      "remainingOutputType": "branch1",
      "resources": {},
      "attributes": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{ $json.body['type'] }}",
              "value2": "checkout.session.completed",
              "operation": "equals"
            }
          ],
          "number": [],
          "dateTime": [],
          "array": [],
          "object": []
        }
      }
    },
    {
      "_id": "validate-hmac",
      "name": "Function: Validate HMAC SHA256",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 300],
      "resources": {},
      "attributes": {
        "jsCode": "// Validate Stripe webhook signature using STRIPE_SIGNING_SECRET env var\nconst payload = $input.first().body;\nconst signature = $input.first().headers['stripe-signature'] || '';\n\nif (!signature) {\n  // No signature — reject silently (could be misconfigured)\n  console.warn('Webhook senza firma Stripe — ignorato');\n  return { json: { rejected: true }, pairedItem: { item: 0 } };\n}\n\n// n8n built-in webhook validation (auto-handled by node if signing secret set)\n// But we validate further for product_type matching\nconst event = $input.first().json;\n\n// Only process kit_base purchases\nif (!event.data?.object?.metadata?.product_type || \n    event.data.object.metadata.product_type !== 'kit_base') {\n  return { json: { ignored: true }, pairedItem: { item: 0 } };\n}\n\nreturn $input.all();\n",
        "mode": "runOnce"
      },
      "discoveredProperties": {}
    },
    {
      "_id": "extract-data",
      "name": "Extract: Customer & Order Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1000, 300],
      "resources": {},
      "attributes": {
        "values": {
          "string": [
            {
              "name": "event_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "session_id",
              "value": "={{ $json.data.object.id }}"
            },
            {
              "name": "customer_email",
              "value": "={{ $json.data.object.customer_email || $json.data.object.email }}"
            },
            {
              "name": "customer_name",
              "value": "={{ $json.data.object.customer_name || $json.data.object.billing_details?.name || '' }}"
            },
            {
              "name": "amount",
              "value": "={{ Math.round($json.data.object.amount_received / 100) }}"
            },
            {
              "name": "currency",
              "value": "={{ $json.data.object.currency }}"
            },
            {
              "name": "payment_status",
              "value": "={{ $json.data.object.payment_status }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            },
            {
              "name": "pdf_url",
              "value": "https://marketing-dentisti.it/kit-base.pdf"
            }
          ]
        },
        "options": {}
      },
      "discoveredFields": {}
    },
    {
      "_id": "sheets-append",
      "name": "Google Sheets: Append Acquisto",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1250, 300],
      "credentials": {},
      "resources": {},
      "attributes": {
        "operation": "append",
        "sheetName": "Acquisti_KitBase",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "event_id": "={{ $json.event_id }}",
            "session_id": "={{ $json.session_id }}",
            "customer_email": "={{ $json.customer_email }}",
            "customer_name": "={{ $json.customer_name }}",
            "amount": "={{ $json.amount }}",
            "currency": "={{ $json.currency }}",
            "payment_status": "={{ $json.payment_status }}",
            "status": "Paid"
          }
        },
        "sheetId": "",
        "range": ""
      },
      "discoveredProperties": {
        "sheetOptions": true
      },
      "icon": "file:nodes/googleSheets.svg"
    },
    {
      "_id": "send-email",
      "name": "SendGrid: Email Consegna Kit Base",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1500, 300],
      "credentials": {},
      "resources": {},
      "attributes": {
        "operations": {
          "mode": "send",
          "to": "={{ $json.customer_email }}",
          "from": "noreply@marketing-dentisti.it",
          "subject": "Ecco il tuo Kit Base 🦷",
          "text": "",
          "html": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Kit Base</title></head><body style='font-family:system-ui,sans-serif;max-width:600px;margin:0;padding:0;color:#1e293b;background:#fff'><div style='background:linear-gradient(135deg,#f0f9ff 0%,#e0f2fe 100%);padding:32px 24px;text-align:center'><h1 style='margin:0 0 8px;font-size:24px;color:#0f172a'>Pagamento completato! 🎉</h1><p style='margin:0;font-size:16px;color:#334155'>Grazie per l'acquisto del tuo <strong>Kit Base</strong></p></div><div style='padding:32px 24px'><h2 style='color:#0f172a'>Il tuo Kit Base</h2><p>Come promesso, ecco il link per scaricare il pacchetto completo dei <strong>7 template operativi</strong>:</p><div style='text-align:center;margin:24px 0'><a href='{{ pdf_url }}' target='_blank' style='display:inline-block;background:#2563eb;color:#fff;padding:14px 32px;border-radius:12px;text-decoration:none;font-weight:600;font-size:16px'>⬇ Scarica il PDF del Kit</a></div><h3 style='color:#0f172a'>Cosa include:</h3><ul style='list-style:none;padding:0'><li style='padding:6px 0;color:#475569'>✅ Messaggio di benvenuto WhatsApp</li><li style='padding:6px 0;color:#475569'>✅ Reminder pre-appuntamento (48h)</li><li style='padding:6px 0;color:#475569'>✅ Richiesta recensione post-visita</li><li style='padding:6px 0;color:#475569'>✅ Email di conferma appuntamento</li><li style='padding:6px 0;color:#475569'>✅ Seguito dopo trattamento</li><li style='padding:6px 0;color:#475569'>✅ Campaigns promozionali stagionali</li><li style='padding:6px 0;color:#475569'>✅ Flusso referral / invita un amico</li></ul><hr style='border:none;border-top:1px solid #e2e8f0;margin:24px 0'/><h3 style='color:#0c4a6e'>Vuoi che tutto giri in automatico?</h3><p style='color:#334155'>Con il servizio <strong>Avvio Studio</strong> personalizziamo i template sul tono del tuo studio e configuriamo WhatsApp Business, le automazioni email e formiamo la segreteria.</p><p style='margin-top:16px'><a href='https://cal.com/marketing-dentisti/avvio-studio' target='_blank' style='display:inline-block;background:#0ea5e9;color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;font-weight:600'>Prenota una call gratuita — €497 una tantum</a></p></div><footer style='background:#f8fafc;padding:20px 24px;text-align:center;font-size:13px;color:#64748b'><p>© 2026 Marketing dentisti · <a href='https://marketing-dentisti.it/privacy' style='color:#64748b'>Privacy</a> · <a href='https://marketing-dentisti.it/termini' style='color:#64748b'>Termini</a></p></footer></body></html>"
      },
      "discoveredProperties": {},
      "icon": "file:nodes/sendGrid.svg"
    },
    {
      "_id": "error-trigger",
      "name": "Error: Notifica Fail",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1500, 550],
      "credentials": {},
      "resources": {},
      "alwaysOutputData": false,
      "attributes": {
        "operations": {
          "mode": "send",
          "to": "ops@marketing-dentisti.it",
          "from": "alert@marketing-dentisti.it",
          "subject":="[DRAFT-FAIL] Kit Base consegna fallita — {{ $json.error?.message || 'Errore ignoto' }}",
          "html": "<p>Il workflow <strong>Kit Base - Consegna Pagata</strong> ha incontrato un errore.</p><pre style='background:#f1f5f9;padding:12px;border-radius:6px;font-size:12px'>{{ JSON.stringify($json, null, 2) }}</pre>"
        }
      },
      "discoveredProperties": {},
      "icon": "file:nodes/sendGrid.svg",
      "notes": "Collegare all'output error del nodo SendGrid principale per notifica errori"
    }
  ],
  "connections": {
    "Webhook Stripe: checkout.session.completed": {
      "main": [
        { "destinationNode": "Filter: Solo checkout.session.completed", "destinationType": "main", "sourceIndex": 0 }
      ]
    },
    "Filter: Solo checkout.session.completed": {
      "main": [
        { "destinationNode": "Function: Validate HMAC SHA256", "destinationType": "main", "sourceIndex": 0 },
        { "destinationNode": "Function: Validate HMAC SHA256", "destinationType": "main", "sourceIndex": 1 }
      ]
    },
    "Function: Validate HMAC SHA256": {
      "main": [
        { "destinationNode": "Extract: Customer & Order Data", "destinationType": "main", "sourceIndex": 0 }
      ]
    },
    "Extract: Customer & Order Data": {
      "main": [
        { "destinationNode": "Google Sheets: Append Acquisto", "destinationType": "main", "sourceIndex": 0 }
      ]
    },
    "Google Sheets: Append Acquisto": {
      "main": [
        { "destinationNode": "SendGrid: Email Consegna Kit Base", "destinationType": "main", "sourceIndex": 0 }
      ]
    },
    "SendGrid: Email Consegna Kit Base": {
      "main": [],
      "error": [
        { "destinationNode": "Error: Notifica Fail", "destinationType": "main", "sourceIndex": 0 }
      ]
    }
  },
  "pinData": {
