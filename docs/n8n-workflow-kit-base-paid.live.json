      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst item = $input.all()[0];\nconst crypto = require('crypto');\nconst SECRET = '[REDACTED]';\nconst b = item.binary && item.binary.data && item.binary.data.data;\nconst rawBody = b ? Buffer.from(b, 'base64').toString('utf8') : '';\nconst headers = item.json.headers || {};\nconst sig = headers['stripe-signature'] || headers['Stripe-Signature'] || '';\nconst event = (item.json.body && typeof item.json.body === 'object') ? item.json.body : null;\nlet ts = '';\nconst v1s = [];\nfor (const part of sig.split(',')) {\n  const idx = part.indexOf('=');\n  if (idx < 1) continue;\n  const k = part.substring(0, idx).trim();\n  const v = part.substring(idx + 1).trim();\n  if (k === 't') ts = v;\n  if (k === 'v1') v1s.push(v);\n}\nlet ok = false;\nif (rawBody && ts && v1s.length > 0) {\n  const computed = crypto.createHmac('sha256', SECRET).update(ts + '.' + rawBody).digest('hex');\n  const a = Buffer.from(computed, 'utf8');\n  for (const v1 of v1s) {\n    const bb = Buffer.from(v1, 'utf8');\n    if (a.length === bb.length && crypto.timingSafeEqual(a, bb)) { ok = true; break; }\n  }\n}\nif (!ok) return [{ json: { _route: 'reject', reason: 'invalid_signature' } }];\nif (!event || event.type !== 'checkout.session.completed') return [{ json: { _route: 'ignored', reason: 'event_type' } }];\nconst s = (event.data && event.data.object) || {};\nconst pt = s.metadata && s.metadata.product_type;\nconst PRICE_ID = 'price_1Ucuk61cfqUaCrbBkWsXmIx5';\nlet priceOk = false;\nconst li = s.line_items && s.line_items.data;\nif (Array.isArray(li)) {\n  for (const it of li) {\n    const p = it.price;\n    const pid = (typeof p === 'string') ? p : (p && p.id);\n    if (pid === PRICE_ID) { priceOk = true; break; }\n  }\n}\nif (pt !== 'kit_base' && !priceOk) return [{ json: { _route: 'ignored', reason: 'product_type' } }];\nlet coupon = '';\nconst d = (s.discounts && s.discounts[0]) || null;\nif (d) {\n  const cp = d.coupon;\n  if (typeof cp === 'string') coupon = cp;\n  else if (cp && typeof cp === 'object') coupon = cp.name || cp.id || '';\n}\nconst cents = (s.amount_total != null ? s.amount_total : (s.amount_received != null ? s.amount_received : 0));\nreturn [{ json: {\n  _route: 'process',\n  timestamp: new Date().toISOString(),\n  event_id: event.id || '',\n  session_id: s.id || '',\n  customer_email: s.customer_email || (s.customer_details && s.customer_details.email) || '',\n  customer_name: s.customer_name || (s.customer_details && s.customer_details.name) || '',\n  amount: Math.round((Number(cents) || 0) / 100),\n  currency: s.currency || 'eur',\n  coupon: coupon,\n  payment_status: s.payment_status || ''\n} }];\n"
